# Files whose bytes are hashed must be identical on every checkout, so they are always LF,
# whatever core.autocrlf says. A CRLF copy of corpus/manifest.json hashes differently from the
# Ceph copy (D5: 22e9471b...), and anchors hash the corpus Markdown byte for byte.

# Frozen corpus: manifest.json (its sha256 goes into every run's config.json) and any Markdown.
corpus/** text eol=lf

# The 10 D1 Docling papers the anchor and broker tests treat as corpus files.
tests/D1/docling/** text eol=lf

# Schemas and worked examples the concept/answer code validates and hashes.
agent/schemas/** text eol=lf
agent/tests/fixtures/** text eol=lf

# Hash-chained logs (events.jsonl, claims.jsonl) and other JSON Lines records.
*.jsonl text eol=lf

# The system prompt (its sha256 goes into config.json).
tests/B/system_prompt.txt text eol=lf

# Shell and Slurm scripts run on the Linux node; CRLF breaks them.
*.sh text eol=lf
*.sbatch text eol=lf
scripts/omen-tunnels text eol=lf
scripts/omen-tunnels-external text eol=lf

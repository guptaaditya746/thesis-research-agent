# Ontology of the RAG pack: the CS-KG 2.0 seed (https://scholkg.kmi.open.ac.uk/cskg/ontology) plus one class per
# canonical metric of words.yaml. Hand-written from the CS-KG specification (no download); see provenance.json.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix cskg: <https://w3id.org/cskg/ontology#> .
@prefix rag: <https://example.org/rag-pack#> .

cskg:Method a owl:Class .
cskg:Metric a owl:Class .
cskg:Material a owl:Class .
cskg:Task a owl:Class .
cskg:OtherEntity a owl:Class .
cskg:based-on a owl:ObjectProperty .

rag:FactualAccuracy a owl:Class ; rdfs:label "factual_accuracy" ; rdfs:subClassOf cskg:Metric .
rag:HallucinationRate a owl:Class ; rdfs:label "hallucination_rate" ; rdfs:subClassOf cskg:Metric .

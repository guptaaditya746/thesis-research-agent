{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "batch.schema.json",
  "title": "Run manifest for `agent batch` (milestones-1-2.md, row 2.9)",
  "description": "Runs = questions x conditions x repeats. Run key <question>-<condition>-r<repeat>; seed = seed_base + 100 * question number (1-based, manifest order) + repeat, the same in both conditions. Relative paths are relative to the directory `agent batch` runs in (the repo root on the cluster).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "runs_root", "questions", "conditions", "repeats", "temperature", "seed_base"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "notes": {"type": "string"},
    "runs_root": {"type": "string", "minLength": 1},
    "corpus": {"type": "string", "minLength": 1, "description": "frozen corpus directory (default: $CORPUS)"},
    "corpus_manifest": {"type": "string", "minLength": 1, "description": "default: <corpus>/manifest.json"},
    "questions": {
      "type": "array", "minItems": 1, "maxItems": 99,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "concept"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_]{0,31}$"},
          "concept": {"type": "string", "minLength": 1, "description": "the frozen concept.json (row 2.3)"}
        }
      }
    },
    "conditions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["claim_on", "claim_off"]}
    },
    "repeats": {"type": "integer", "minimum": 1, "maximum": 99},
    "temperature": {"type": "number", "minimum": 0},
    "seed_base": {"type": "integer", "minimum": 0},
    "budget": {
      "type": "object", "additionalProperties": false,
      "properties": {"steps": {"type": "integer", "minimum": 1}, "tokens": {"type": "integer", "minimum": 1}}
    },
    "prompt_version": {"type": "string", "pattern": "^v[0-9]+$",
                       "description": "agent/prompts/system-<version>.txt (and attach-<version>.txt) for every run (default: agent run's)"},
    "conclude_decoding": {"enum": ["structured_outputs", "guided_json", "free"],
                          "description": "how conclude replies are decoded, in runs and attach steps (default: the prompt version's)"},
    "attach_budget": {
      "type": "object", "additionalProperties": false,
      "description": "the attach step's budget per fact (row 2.5)",
      "properties": {"steps": {"type": "integer", "minimum": 1}, "tokens": {"type": "integer", "minimum": 1}}
    },
    "sandbox": {"enum": ["landlock", "unsandboxed"]},
    "agent_root": {"type": "string", "minLength": 1, "description": "pinned toolchain (default: $AGENT_ROOT)"},
    "base_url": {"type": "string", "minLength": 1},
    "broker": {"enum": ["auto", "process", "inprocess"]},
    "path_extra": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "max_attempts": {"type": "integer", "minimum": 1, "description": "runs of one key, cut ones included (default 3)"}
  }
}

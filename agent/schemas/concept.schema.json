{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "concept.schema.json",
  "title": "Concept brief (plan.md 5.2 without subschema; frozen in milestone 1, row 1.3)",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "definition", "measure", "scope", "answer_shape", "competency_questions"],
  "properties": {
    "id": {"type": "string", "pattern": "^c[0-9]+$"},
    "title": {"$ref": "#/$defs/text"},
    "definition": {"$ref": "#/$defs/text", "description": "One line: what is measured, over what"},
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "of"],
      "description": "The operation behind the definition; briefs are diffed on this field",
      "properties": {
        "operation": {"$ref": "#/$defs/word", "description": "e.g. count, list, rank, compare, sum, mean"},
        "of": {"$ref": "#/$defs/word", "description": "what is counted or listed, e.g. Paper"},
        "group_by": {"$ref": "#/$defs/word"},
        "filter": {"$ref": "#/$defs/text"},
        "order": {"enum": ["asc", "desc"]},
        "limit": {"type": "integer", "minimum": 1}
      }
    },
    "scope": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/text"},
      "description": "Which part of the corpus counts, e.g. {\"papers\": \"venue == ACL 2025\"}"
    },
    "answer_shape": {"oneOf": [{"$ref": "#/$defs/table"}, {"$ref": "#/$defs/graph"}]},
    "competency_questions": {
      "type": "array", "minItems": 2, "maxItems": 3, "uniqueItems": true,
      "items": {"$ref": "#/$defs/text"}
    },
    "needs": {"type": "array", "items": {"$ref": "#/$defs/text"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "word": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_ -]*$"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "value_type": {
      "type": "string",
      "pattern": "^(integer|number|string|boolean|date|[A-Z][A-Za-z]*|list<(integer|number|string|date|[A-Z][A-Za-z]*)>)$",
      "description": "Scalars, an ontology class name (Person, Paper, Dataset; a string label in the answer), or a list of one of them"
    },
    "class": {"type": "string", "pattern": "^[A-Z][A-Za-z]*$"},
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "columns"],
      "properties": {
        "kind": {"const": "table"},
        "columns": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "type"],
            "properties": {"name": {"$ref": "#/$defs/name"}, "type": {"$ref": "#/$defs/value_type"}}
          }
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "nodes", "edges"],
      "properties": {
        "kind": {"const": "graph"},
        "nodes": {
          "type": "array", "minItems": 1,
          "items": {"type": "object", "additionalProperties": false, "required": ["type"],
                    "properties": {"type": {"$ref": "#/$defs/class"}}}
        },
        "edges": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["source", "predicate", "target"],
            "properties": {
              "source": {"$ref": "#/$defs/class"},
              "predicate": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]*$"},
              "target": {"$ref": "#/$defs/class"},
              "attributes": {
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false, "required": ["name", "type"],
                  "properties": {"name": {"$ref": "#/$defs/name"}, "type": {"$ref": "#/$defs/value_type"}}
                }
              }
            }
          }
        }
      }
    }
  }
}

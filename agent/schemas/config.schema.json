{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config.schema.json",
  "title": "Run config (milestones-1-2.md, Fixed run settings)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "created_at", "condition", "models", "budget", "sampling",
               "command_limits", "prompt", "hashes", "git_commit"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"$ref": "#/$defs/run_id"},
    "created_at": {"type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(\\.\\d+)?Z$"},
    "condition": {"enum": ["claim_on", "claim_off"], "description": "claim_off is the baseline (2.4)"},
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orchestrator", "subagents"],
      "properties": {
        "orchestrator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["alias", "name", "revision", "thinking", "max_tokens", "context_tokens"],
          "properties": {
            "alias": {"type": "string", "minLength": 1},
            "name": {"type": "string", "minLength": 1},
            "revision": {"$ref": "#/$defs/revision"},
            "thinking": {"type": "boolean"},
            "max_tokens": {"type": "integer", "minimum": 1},
            "context_tokens": {"type": "integer", "minimum": 1}
          }
        },
        "subagents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["alias", "name", "revision", "context_tokens"],
            "properties": {
              "alias": {"type": "string", "minLength": 1},
              "name": {"type": "string", "minLength": 1},
              "revision": {"$ref": "#/$defs/revision"},
              "context_tokens": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "tokens", "announced"],
      "properties": {
        "steps": {"type": "integer", "minimum": 1},
        "tokens": {"type": "integer", "minimum": 1},
        "announced": {"type": "boolean"}
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temperature", "seed"],
      "properties": {
        "temperature": {"type": "number", "minimum": 0},
        "seed": {"type": "integer"}
      }
    },
    "command_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_s", "ulimit_v_kib", "output_cap_bytes"],
      "properties": {
        "timeout_s": {"type": "integer", "minimum": 1},
        "ulimit_v_kib": {"type": "integer", "minimum": 1},
        "output_cap_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept_sha256", "corpus_manifest_sha256", "agent_root_manifest_sha256"],
      "properties": {
        "concept_sha256": {"$ref": "#/$defs/sha256"},
        "corpus_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "agent_root_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  },
  "$defs": {
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

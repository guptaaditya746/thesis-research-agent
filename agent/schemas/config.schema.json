{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config.schema.json",
  "title": "Run config (docs/earlier-work.md, Fixed run settings)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "created_at", "condition", "models", "budget", "sampling",
               "command_limits", "prompt", "hashes", "git_commit"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"$ref": "#/$defs/run_id"},
    "created_at": {"type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(\\.\\d+)?Z$"},
    "condition": {"enum": ["claim_on", "claim_off"], "description": "claim_off is the baseline (2.4)"},
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orchestrator", "subagents"],
      "properties": {
        "orchestrator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["alias", "name", "revision", "thinking", "max_tokens", "context_tokens"],
          "properties": {
            "alias": {"type": "string", "minLength": 1},
            "name": {"type": "string", "minLength": 1},
            "revision": {"$ref": "#/$defs/revision"},
            "thinking": {"type": "boolean"},
            "max_tokens": {"type": "integer", "minimum": 1},
            "context_tokens": {"type": "integer", "minimum": 1}
          }
        },
        "subagents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["alias", "name", "revision", "context_tokens"],
            "properties": {
              "alias": {"type": "string", "minLength": 1},
              "name": {"type": "string", "minLength": 1},
              "revision": {"$ref": "#/$defs/revision"},
              "context_tokens": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "tokens", "announced"],
      "properties": {
        "steps": {"type": "integer", "minimum": 1},
        "tokens": {"type": "integer", "minimum": 1},
        "announced": {"type": "boolean"}
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temperature", "seed"],
      "properties": {
        "temperature": {"type": "number", "minimum": 0},
        "seed": {"type": "integer"}
      }
    },
    "command_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_s", "ulimit_v_kib", "output_cap_bytes"],
      "properties": {
        "timeout_s": {"type": "integer", "minimum": 1},
        "ulimit_v_kib": {"type": "integer", "minimum": 1},
        "output_cap_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256", "description": "sha256 of the system prompt file"},
        "files": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/sha256"},
          "description": "sha256 of every prompt file the run used, by file name (row 1.8)"
        }
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept_sha256", "corpus_manifest_sha256", "agent_root_manifest_sha256"],
      "properties": {
        "concept_sha256": {"$ref": "#/$defs/sha256"},
        "corpus_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "agent_root_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "description": "Which sandbox ran the agent's commands (row 1.8). unsandboxed is for tests and machines without Landlock only",
      "properties": {
        "mode": {"enum": ["landlock", "unsandboxed"]},
        "landlock_abi": {"type": ["integer", "null"]},
        "agent_root": {"type": ["string", "null"]}
      }
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness", "base_url"],
      "properties": {
        "harness": {"type": "string", "minLength": 1, "description": "e.g. mini-swe-agent 2.4.6"},
        "base_url": {"type": "string", "minLength": 1, "description": "the LiteLLM endpoint; never a key"},
        "conclude_replies": {"type": "integer", "minimum": 1,
                             "description": "replies allowed after the budget or the context runs out"},
        "conclude_decoding": {"enum": ["free", "structured_outputs", "guided_json"],
                              "description": "conclude replies decoded freely or under the reply schema (extra_body key; rows 1.13)"},
        "conclude_max_tokens": {"type": ["integer", "null"], "minimum": 1,
                                "description": "max_tokens of a conclude reply, within what the context leaves; null = the orchestrator's max_tokens"},
        "masking": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["keep", "keep_tight", "tight_above_prompt_tokens"],
          "description": "row 1.15: outputs older than the last `keep` commands become stubs; `keep_tight` after a prompt over `tight_above_prompt_tokens`; null = off",
          "properties": {
            "keep": {"type": "integer", "minimum": 1},
            "keep_tight": {"type": "integer", "minimum": 1},
            "tight_above_prompt_tokens": {"type": "integer", "minimum": 1}
          }
        },
        "budget_warnings": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 99},
                            "description": "percent of either budget at which the agent gets a one-time notice"},
        "repeat_stop": {"type": "integer", "minimum": 0,
                        "description": "identical commands in a row that end research; 0 = never"},
        "draft_file": {"type": ["string", "null"],
                       "description": "the agent's draft answer in scratch/, taken when the run ends without an answer"},
        "m1_notices": {"type": "boolean",
                       "description": "the M1-real loop's wording (context-full stub without the output file, no reply-limit line); prompt v1"}
      }
    },
    "attach": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "budget_per_fact", "conclude_replies", "first_step", "started_at"],
      "description": "The baseline's attach step (row 2.5), added to a claim_off run's config when the step starts",
      "properties": {
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "sha256", "files"],
          "properties": {
            "version": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256", "description": "sha256 of the attach system prompt file"},
            "files": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}}
          }
        },
        "budget_per_fact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["steps", "tokens", "announced"],
          "properties": {
            "steps": {"type": "integer", "minimum": 1},
            "tokens": {"type": "integer", "minimum": 1},
            "announced": {"type": "boolean"}
          }
        },
        "conclude_replies": {"type": "integer", "minimum": 0},
        "conclude_decoding": {"enum": ["free", "structured_outputs", "guided_json"],
                              "description": "conclude replies decoded freely or under the result schema (default: the run's loop.conclude_decoding)"},
        "first_step": {"type": "integer", "minimum": 1, "description": "step id of the attach step's first model call"},
        "started_at": {"type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(\\.\\d+)?Z$"},
        "base_url": {"type": "string", "minLength": 1},
        "sandbox": {"enum": ["landlock", "unsandboxed"]}
      }
    },
    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "description": "Row 2.12: the spawn command (subagents on sub-model-1/-2, agent/spawn.py); agent run --spawn on|off, off by default. The rest is set only when enabled",
      "properties": {
        "enabled": {"type": "boolean"},
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["steps", "tokens", "announced"],
          "description": "each subagent's own budget; spawn --steps may lower the steps",
          "properties": {
            "steps": {"type": "integer", "minimum": 1},
            "tokens": {"type": "integer", "minimum": 1},
            "announced": {"type": "boolean"}
          }
        },
        "max_concurrent": {"type": "integer", "minimum": 1, "description": "subagents running at once (one per sub-model replica); the rest wait"},
        "max_subagents": {"type": "integer", "minimum": 1, "description": "subagents one run may start"},
        "command_timeout_s": {"type": "integer", "minimum": 1, "description": "time limit of a command that calls spawn (others keep command_limits.timeout_s)"},
        "models": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "the sub-model aliases, one per worker"},
        "max_tokens": {"type": "integer", "minimum": 1, "description": "a subagent's reply limit"},
        "claim": {"type": "boolean", "description": "subagents have claim iff the run is claim_on"},
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "sha256", "files"],
          "properties": {
            "version": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256", "description": "sha256 of the subagent system prompt file"},
            "files": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}}
          }
        },
        "loop": {"type": "object", "description": "the subagents' loop settings (loop.LoopSettings.config())"}
      }
    }
  },
  "$defs": {
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

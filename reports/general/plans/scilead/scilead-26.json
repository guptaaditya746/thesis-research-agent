    {
      "id": "l1",
      "question": "Which method has the highest Accuracy on the Switchboard Dialog Act Corpus (SWDA)?",
      "query": "# params: metric\nSELECT (MIN(?name) AS ?thing) (IF(SAMPLE(?higher), SAMPLE(?best), -SAMPLE(?best)) AS ?score) (MIN(?pname) AS ?paper) WHERE {\n  {\n    SELECT ?t (MAX(?bkey) AS ?best) WHERE {\n      ?bv a ev:Value ; ev:of ?t ; ev:onMetric ?bm ; ev:number ?bnumber ; ev:inExperiment ?be ; kg:contextKey \"Switchboard Dialog Act Corpus (SWDA)\" .\n      ?bm ev:name $metrics .\n      ?be ev:inPaper ?bp .\n      ?bp ev:name ?bpaper .\n      OPTIONAL { ?bm kg:higherIsBetter ?bh }\n      BIND(IF(COALESCE(?bh, true), ?bnumber, -?bnumber) AS ?bkey)\n      $include[?bpaper]\n    }\n    GROUP BY ?t\n  }\n  ?v a ev:Value ; ev:of ?t ; ev:onMetric ?m ; ev:number ?number ; ev:inExperiment ?e ; kg:contextKey \"Switchboard Dialog Act Corpus (SWDA)\" .\n  ?m ev:name $metrics .\n  ?t ev:name ?name .\n  ?e ev:inPaper ?p .\n  ?p ev:name ?pname .\n  OPTIONAL { ?m kg:higherIsBetter ?h }\n  BIND(COALESCE(?h, true) AS ?higher)\n  BIND(IF(?higher, ?number, -?number) AS ?key)\n  FILTER(?key = ?best)\n  $include[?pname]\n}\nGROUP BY ?t\nORDER BY DESC(SAMPLE(?best)) ?thing",
      "template": "rank",
      "removable": true,
      "how": []
    },
    {
      "id": "l2",
      "question": "Which papers report Accuracy results on the Switchboard Dialog Act Corpus (SWDA)?",
      "query": "SELECT DISTINCT ?paper WHERE { ?v a ev:Value ; kg:side ?s ; ev:onMetric ?m ; ev:inExperiment ?e . ?m ev:name ?metric . ?e ev:inPaper ?p . ?p ev:name ?paper . VALUES ?s { $sides } VALUES ?metric { $metrics } }",
      "template": null,
      "removable": true,
      "how": [
        "It looks at every recorded value in the experiments.",
        "It keeps those where the side and the metric match your chosen options.",
        "It returns the name of the paper that contains the experiment."
      ]
    }
  ],

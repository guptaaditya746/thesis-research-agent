  "question": "Which paper reports the best result on XSum by ROGUE-L?",
  "field": "cs",
  "lines": [
    {
      "id": "l1",
      "question": "Which paper has the highest ROGUE-L score on XSum?",
      "query": "# params: metric\nSELECT (MIN(?name) AS ?thing) (IF(SAMPLE(?higher), SAMPLE(?best), -SAMPLE(?best)) AS ?score) (MIN(?pname) AS ?paper) WHERE {\n  {\n    SELECT ?t (MAX(?bkey) AS ?best) WHERE {\n      ?bv a ev:Value ; ev:of ?t ; ev:onMetric ?bm ; ev:number ?bnumber ; ev:inExperiment ?be ; kg:contextKey \"XSum\" .\n      ?bm ev:name $metrics .\n      ?be ev:inPaper ?bp .\n      ?bp ev:name ?bpaper .\n      OPTIONAL { ?bm kg:higherIsBetter ?bh }\n      BIND(IF(COALESCE(?bh, true), ?bnumber, -?bnumber) AS ?bkey)\n      $include[?bpaper]\n    }\n    GROUP BY ?t\n  }\n  ?v a ev:Value ; ev:of ?t ; ev:onMetric ?m ; ev:number ?number ; ev:inExperiment ?e ; kg:contextKey \"XSum\" .\n  ?m ev:name $metrics .\n  ?t ev:name ?name .\n  ?e ev:inPaper ?p .\n  ?p ev:name ?pname .\n  OPTIONAL { ?m kg:higherIsBetter ?h }\n  BIND(COALESCE(?h, true) AS ?higher)\n  BIND(IF(?higher, ?number, -?number) AS ?key)\n  FILTER(?key = ?best)\n  $include[?pname]\n}\nGROUP BY ?t\nORDER BY DESC(SAMPLE(?best)) ?thing",
      "template": "rank",
      "removable": true,
      "how": []
    }
  ],
  "main_rule": "any_line",

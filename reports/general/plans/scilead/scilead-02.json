      "question": "Which paper has the highest ROGUE-2 score on the Gigaword dataset?",
      "query": "# params: counts_as\n# decisions: counts_as=counts_as\nSELECT ?kind (MIN(?name) AS ?thing) (COUNT(DISTINCT ?unit) AS ?count) WHERE {\n  ?c a ev:Comparison ; ev:better ?v ; ev:inExperiment ?e .\n  ?v ev:of ?t ; ev:onMetric ?m .\n  ?m ev:name \"rogue_2\" .\n  ?t ev:name ?name .\n  ?e ev:inPaper ?p .\n  ?p ev:name ?paper .\n  VALUES ?kind { $counts_as }\n  BIND(IF(?kind = \"paper\", STR(?p), STR(?v)) AS ?unit)\n  $include[?paper]\n}\nGROUP BY ?kind ?t\nORDER BY ?kind DESC(?count) ?thing",

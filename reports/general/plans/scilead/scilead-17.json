      "id": "l1",
      "question": "Which model achieves the highest BLEU score on WMT'14 EN-DE?",
      "query": "# params: metric\nSELECT (MIN(?name) AS ?thing) (IF(SAMPLE(?higher), SAMPLE(?best), -SAMPLE(?best)) AS ?score) (MIN(?pname) AS ?paper) WHERE {\n  {\n    SELECT ?t (MAX(?bkey) AS ?best) WHERE {\n      ?bv a ev:Value ; ev:of ?t ; ev:onMetric ?bm ; ev:number ?bnumber ; ev:inExperiment ?be ; kg:contextKey \"WMT'14 EN-DE\" .\n      ?bm ev:name ?metric .\n      ?be ev:inPaper ?bp .\n      ?bp ev:name ?bpaper .\n      OPTIONAL { ?bm kg:higherIsBetter ?bh }\n      BIND(IF(COALESCE(?bh, true), ?bnumber, -?bnumber) AS ?bkey)\n      $include[?bpaper]\n    }\n    GROUP BY ?t\n  }\n  ?v a ev:Value ; ev:of ?t ; ev:onMetric ?m ; ev:number ?number ; ev:inExperiment ?e ; kg:contextKey \"WMT'14 EN-DE\" .\n  ?m ev:name ?metric .\n  ?t ev:name ?name .\n  ?e ev:inPaper ?p .\n  ?p ev:name ?pname .\n  OPTIONAL { ?m kg:higherIsBetter ?h }\n  BIND(COALESCE(?h, true) AS ?higher)\n  BIND(IF(?higher, ?number, -?number) AS ?key)\n  FILTER(?key = ?best)\n  $include[?pname]\n  VALUES ?metric { $metrics }\n}\nGROUP BY ?t\nORDER BY DESC(SAMPLE(?best)) ?thing",
      "template": "rank",
      "removable": true,
      "how": []
    },
    {
      "id": "l2",
      "question": "Which papers report BLEU scores for WMT'14 EN-DE?",
      "query": "SELECT DISTINCT ?paper WHERE { ?v a ev:Value ; kg:side ?s ; ev:onMetric ?m ; ev:inExperiment ?e . ?m ev:name ?metric . ?e ev:inPaper ?p . ?p ev:name ?paper . VALUES ?s { $sides } VALUES ?metric { $metrics } }",
      "template": null,

  "question": "Which paper reports the best result on SemEval 2013 Task 13 by AVG?",
  "field": "cs",
  "lines": [
    {
      "id": "l1",
      "question": "Which paper has the highest AVG score on SemEval 2013 Task 13?",
      "query": "# params: metric, counts_as\n# decisions: counts_as=counts_as\nSELECT ?kind (MIN(?name) AS ?thing) (COUNT(DISTINCT ?unit) AS ?count) WHERE {\n  ?c a ev:Comparison ; ev:better ?v ; ev:inExperiment ?e .\n  ?v ev:of ?t ; ev:onMetric ?m .\n  ?m ev:name $metrics .\n  ?t ev:name ?name .\n  ?e ev:inPaper ?p .\n  ?p ev:name ?paper .\n  VALUES ?kind { $counts_as }\n  BIND(IF(?kind = \"paper\", STR(?p), STR(?v)) AS ?unit)\n  $include[?paper]\n}\nGROUP BY ?kind ?t\nORDER BY ?kind DESC(?count) ?thing",
      "template": "best",
      "removable": true,
      "how": []
    },
    {
      "id": "l2",
      "question": "What are the AVG scores reported for SemEval 2013 Task 13 in each paper?",
      "query": "SELECT DISTINCT ?paper WHERE { ?v a ev:Value ; kg:side ?s ; ev:onMetric ?m ; ev:inExperiment ?e . ?m ev:name ?metric . ?e ev:inPaper ?p . ?p ev:name ?paper . VALUES ?s { $sides } VALUES ?metric { $metrics } FILTER(?s = \"semeval_2013_task_13\") }",
      "template": null,
      "removable": true,
      "how": [
        "It looks at every recorded value in the experiments.",
        "It keeps those where the side is semeval_2013_task_13 and the metric is one of your chosen ones.",
        "It returns the name of the paper that contains the experiment."
      ]
    }
  ],

PREFIX ev: <https://w3id.org/thesis-ev#>
PREFIX kg: <https://w3id.org/thesis-ev/kg#>
# Papers that report results on two or more different datasets.
SELECT ?paper (COUNT(DISTINCT ?dataset) AS ?datasets) WHERE {
  ?v a ev:Value ; ev:inExperiment ?e ; kg:context ?dataset .
  ?e ev:inPaper ?p .
  ?p ev:name ?paper .
}
GROUP BY ?paper
HAVING (COUNT(DISTINCT ?dataset) >= 2)
ORDER BY ?paper

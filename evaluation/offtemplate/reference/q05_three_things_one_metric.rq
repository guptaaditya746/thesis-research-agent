PREFIX ev: <https://w3id.org/thesis-ev#>
PREFIX kg: <https://w3id.org/thesis-ev/kg#>
# Papers that measure three or more different things on one metric (a wide comparison).
SELECT DISTINCT ?paper WHERE {
  {
    SELECT ?p ?m (COUNT(DISTINCT ?t) AS ?things) WHERE {
      ?v a ev:Value ; ev:of ?t ; ev:onMetric ?m ; ev:inExperiment ?e .
      ?e ev:inPaper ?p .
    }
    GROUP BY ?p ?m
    HAVING (COUNT(DISTINCT ?t) >= 3)
  }
  ?p ev:name ?paper .
}
ORDER BY ?paper

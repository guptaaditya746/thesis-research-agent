PREFIX ev: <https://w3id.org/thesis-ev#>
PREFIX kg: <https://w3id.org/thesis-ev/kg#>
# Pairs of datasets that appear together in one paper.
SELECT ?first ?second (COUNT(DISTINCT ?p) AS ?papers) WHERE {
  ?v1 a ev:Value ; ev:inExperiment ?e1 ; kg:context ?first .
  ?e1 ev:inPaper ?p .
  ?v2 a ev:Value ; ev:inExperiment ?e2 ; kg:context ?second .
  ?e2 ev:inPaper ?p .
  FILTER(STR(?first) < STR(?second))
}
GROUP BY ?first ?second
ORDER BY ?first ?second

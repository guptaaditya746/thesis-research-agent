PREFIX ev: <https://w3id.org/thesis-ev#>
PREFIX kg: <https://w3id.org/thesis-ev/kg#>
# Papers with a value below 0.15 on a metric where lower is better.
SELECT DISTINCT ?paper ?metric WHERE {
  ?v a ev:Value ; ev:onMetric ?m ; ev:number ?n ; ev:inExperiment ?e .
  ?m ev:name ?metric ; kg:higherIsBetter false .
  ?e ev:inPaper ?p .
  ?p ev:name ?paper .
  FILTER(?n < 0.15)
}
ORDER BY ?paper ?metric

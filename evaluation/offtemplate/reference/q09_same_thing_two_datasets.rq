PREFIX ev: <https://w3id.org/thesis-ev#>
PREFIX kg: <https://w3id.org/thesis-ev/kg#>
# Papers that measure the same thing on two different datasets.
SELECT DISTINCT ?paper WHERE {
  ?v1 a ev:Value ; ev:of ?t ; ev:inExperiment ?e1 ; kg:context ?d1 .
  ?v2 a ev:Value ; ev:of ?t ; ev:inExperiment ?e2 ; kg:context ?d2 .
  ?e1 ev:inPaper ?p .
  ?e2 ev:inPaper ?p .
  ?p ev:name ?paper .
  FILTER(?d1 != ?d2)
}
ORDER BY ?paper

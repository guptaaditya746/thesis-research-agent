PREFIX ev: <https://w3id.org/thesis-ev#>
PREFIX kg: <https://w3id.org/thesis-ev/kg#>
# Papers that report more than one metric.
SELECT ?paper (COUNT(DISTINCT ?m) AS ?metrics) WHERE {
  ?v a ev:Value ; ev:onMetric ?m ; ev:inExperiment ?e .
  ?e ev:inPaper ?p .
  ?p ev:name ?paper .
}
GROUP BY ?paper
HAVING (COUNT(DISTINCT ?m) > 1)
ORDER BY ?paper

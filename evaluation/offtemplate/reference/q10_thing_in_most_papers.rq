PREFIX ev: <https://w3id.org/thesis-ev#>
PREFIX kg: <https://w3id.org/thesis-ev/kg#>
# Things measured in two or more papers, with the number of papers.
SELECT ?thing (COUNT(DISTINCT ?p) AS ?papers) WHERE {
  ?v a ev:Value ; ev:of ?t ; ev:inExperiment ?e .
  ?t ev:name ?thing .
  ?e ev:inPaper ?p .
}
GROUP BY ?thing
HAVING (COUNT(DISTINCT ?p) >= 2)
ORDER BY DESC(COUNT(DISTINCT ?p)) ?thing

#!/usr/bin/env python3
"""Open the Omen -> laptop -> Webis gateway -> Slurm compute tunnels."""

import argparse
import http.client
import json
import os
from pathlib import Path
import shlex
import socket
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request


# name: (Omen service port, laptop port, gateway port, compute port)
# `harness-ui` is the reverse path: its server runs on compute and the browser is on laptop.
SERVICES = {
    "tracing": (3004, 23004, 29304, 33004),
    "postgres": (5432, 25432, 29432, 35432),
    "portainer": (9443, 29443, 49443, 39443),
    "dockge": (5001, 25001, 45001, 35001),
    "dozzle": (9999, 29999, 49999, 39999),
    "dagster": (3000, 23000, 43000, 33000),
    "metabase": (3002, 23002, 43002, 33002),
    "evidently": (8008, 28008, 48008, 38008),
    "nessie": (19120, 39120, 59120, 49120),
    "kg-viewer": (8085, 28085, 48085, 38085),
    "kg-studio": (8086, 28086, 48086, 38086),
    "grafana": (3001, 23001, 43001, 33001),
    "cadvisor": (8089, 28089, 48089, 38089),
    "prometheus": (9090, 29090, 49090, 39090),
    "adminer": (8088, 28088, 48088, 38088),
    "redis": (6379, 26379, 46379, 36379),
    "minio-api": (9000, 29000, 49000, 39000),
    "minio-console": (9001, 29001, 49001, 39001),
    "neetcode": (8083, 28083, 48083, 38083),
    "nginx-test": (8080, 28080, 48080, 38080),
    "tracing-postgres": (15432, 35432, 55432, 45432),
    "thesis-postgres": (15433, 35433, 55433, 45433),
    "thesis-redis": (16379, 36380, 56380, 46380),
    "tracing-clickhouse-http": (18123, 38123, 58123, 48123),
    "tracing-clickhouse-native": (19000, 39000, 59000, 49000),
    "argilla": (6900, 26900, 46900, 36900),
    "harness-ui": (None, 25173, 24173, 8080),
}

DEFAULT_SERVICES = ("tracing", "postgres")
GATEWAY = f"{os.environ.get('WEBIS_USER', 'xepi3167')}@ssh.webis.de"
OMEN = f"{os.environ.get('OMEN_USER', 'omen-server')}@{os.environ.get('OMEN_HOST', '192.168.0.107')}"
SSH = os.environ.get("OMEN_TUNNELS_SSH", "ssh")
# omen-tunnels-external sets 1000 so the external gateway uses its legacy ports.
GATEWAY_PORT_OFFSET = int(os.environ.get("OMEN_TUNNELS_GATEWAY_PORT_OFFSET", "0"))
CHECK_TIMEOUT = 5.0


def runtime_dir() -> Path:
    base = Path(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir())
    path = base / f"omen-tunnels-{os.getuid()}-{socket.gethostname()}"
    if path.is_symlink():
        raise RuntimeError(f"Refusing symlinked runtime directory: {path}")
    path.mkdir(mode=0o700, exist_ok=True)
    if path.stat().st_uid != os.getuid():
        raise RuntimeError(f"Runtime directory has another owner: {path}")
    path.chmod(0o700)
    return path


def selected_services(names: list[str]) -> list[str]:
    if not names:
        return list(DEFAULT_SERVICES)
    if names == ["all"]:
        return list(SERVICES)
    unknown = sorted(set(names) - SERVICES.keys())
    if unknown:
        raise ValueError(f"Unknown service(s): {', '.join(unknown)}. Run: omen-tunnels list")
    return list(dict.fromkeys(names))


def forward_args(role: str, names: list[str]) -> list[str]:
    args = []
    for name in names:
        omen, laptop, gateway, compute = SERVICES[name]
        gateway += GATEWAY_PORT_OFFSET
        if name == "harness-ui":
            if role == "gateway":
                # Laptop browser -> gateway reverse listener -> compute web app.
                args += ["-L", f"127.0.0.1:{laptop}:127.0.0.1:{gateway}"]
            elif role == "compute":
                # Gateway listener -> compute web app. Keep the remote listener loopback-only.
                args += ["-R", f"127.0.0.1:{gateway}:127.0.0.1:{compute}"]
            continue
        if role == "omen":
            args += ["-L", f"127.0.0.1:{laptop}:127.0.0.1:{omen}"]
        elif role == "gateway":
            args += ["-R", f"127.0.0.1:{gateway}:127.0.0.1:{laptop}"]
        elif role == "compute":
            args += ["-L", f"127.0.0.1:{compute}:127.0.0.1:{gateway}"]
    return args


def gateway_port(name: str) -> int:
    return SERVICES[name][2] + GATEWAY_PORT_OFFSET


def listener_ports(role: str, names: list[str]) -> list[str]:
    """The ports a hop listens on, and where: a port held there makes ssh fail."""
    ports = []
    for name in names:
        omen, laptop, gateway, compute = SERVICES[name]
        if name == "harness-ui":
            if role == "gateway":
                ports.append(f"{laptop} on laptop")
            elif role == "compute":
                ports.append(f"{gateway_port(name)} on gateway")
        elif role == "omen":
            ports.append(f"{laptop} on laptop")
        elif role == "gateway":
            ports.append(f"{gateway_port(name)} on gateway")
        else:
            ports.append(f"{compute} on compute")
    return ports


def accepts(port: int, host: str = "127.0.0.1", timeout: float = 2.0) -> bool:
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


def check_ui_server(names: list[str]) -> None:
    """compute start: the harness-ui hop forwards to 127.0.0.1:8080 of this machine, so the web app must listen here."""
    if "harness-ui" not in names:
        return
    port = SERVICES["harness-ui"][3]
    if not accepts(port):
        raise RuntimeError(
            f"Nothing accepts connections on 127.0.0.1:{port} on {socket.gethostname()}. The harness-ui hop "
            f"forwards to port {port} of the machine it runs on, so start 'webapp serve --port {port}' first and run "
            f"'compute start harness-ui' on that same node (from the login node: srun --jobid $JOB --overlap --pty "
            "bash -l). --no-check skips this check.")


def fetch(url: str, timeout: float = CHECK_TIMEOUT) -> tuple[int | None, str]:
    """(status, body) of a GET without any proxy; (None, what went wrong) when no HTTP answer came."""
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    try:
        with opener.open(url, timeout=timeout) as response:
            return response.status, response.read(2000).decode("utf-8", "replace")
    except urllib.error.HTTPError as exc:
        return exc.code, exc.read(2000).decode("utf-8", "replace")
    except urllib.error.URLError as exc:
        if isinstance(exc.reason, ConnectionRefusedError):
            return None, "connection refused: nothing listens on this port here"
        return None, str(exc.reason)
    except (http.client.RemoteDisconnected, ConnectionResetError, http.client.BadStatusLine):
        return None, ("connection closed without an answer: the SSH hop listens, but its far end reaches no server "
                      "(compute hop down, started on another node, or with another gateway port)")
    except (OSError, http.client.HTTPException) as exc:
        return None, str(exc) or type(exc).__name__


def check_ui(port: int, timeout: float = CHECK_TIMEOUT) -> int:
    """GET / and /api/health through the harness-ui port; print what answered."""
    url = f"http://127.0.0.1:{port}/"
    status, body = fetch(url, timeout)
    if status is None:
        print(f"{url}: no HTTP answer ({body})")
        return 1
    print(f"{url}: HTTP {status}")
    if status == 400:
        print(f"  the web app's guard refused it: {body.strip()}")
    elif status != 200:
        print(f"  body: {body.strip()[:300]}")
    health, _ = fetch(url + "api/health", timeout)
    if health == 200:
        print(f"{url}api/health: HTTP 200, the web app answers")
    else:
        print(f"{url}api/health: {'HTTP ' + str(health) if health else 'no answer'}; "
              "what answers is probably not 'webapp serve'")
    return 0 if status == 200 and health == 200 else 1


def ready_lines(machine: str, names: list[str]) -> list[str]:
    """What start prints: both ends print the gateway ports, so the two sides can be compared."""
    lines = [f"Ready (gateway port offset {GATEWAY_PORT_OFFSET}). On the other end use the same service names and "
             "the same command (omen-tunnels-external: offset 1000, omen-tunnels: 0)."]
    for name in names:
        omen, laptop, gateway, compute = SERVICES[name]
        if name == "harness-ui" and machine == "laptop":
            lines.append(f"  {name}: http://127.0.0.1:{laptop} in the laptop browser (gateway port {gateway_port(name)})")
        elif name == "harness-ui":
            lines.append(f"  {name}: gateway port {gateway_port(name)} -> 127.0.0.1:{compute} on "
                         f"{socket.gethostname()}")
        else:
            lines.append(f"  {name}: 127.0.0.1:{compute} on compute (gateway port {gateway_port(name)})")
    return lines


def ssh_command(role: str, names: list[str], sock: Path) -> list[str]:
    cmd = [SSH]
    if role == "omen":
        cmd += ["-F", "/dev/null", "-i", os.path.expanduser(os.environ.get("OMEN_SSH_KEY", "~/.ssh/id_ed25519"))]
    elif role == "compute":
        cmd += ["-i", os.path.expanduser(os.environ.get("WEBIS_TUNNEL_KEY", "~/.ssh/id_ed25519_webis_tunnel"))]
    cmd += [
        "-M", "-f", "-N", "-S", str(sock),
    ]
    if role != "gateway":
        cmd += ["-o", "IdentitiesOnly=yes"]
    cmd += [
        "-o", "ExitOnForwardFailure=yes",
        "-o", "ServerAliveInterval=30",
        "-o", "ServerAliveCountMax=3",
    ]
    cmd += forward_args(role, names)
    cmd.append(OMEN if role == "omen" else GATEWAY)
    return cmd


def control_command(sock: Path, action: str, target: str) -> list[str]:
    return [SSH, "-S", str(sock), "-O", action, target]


def active(sock: Path, target: str) -> bool:
    if not sock.exists():
        return False
    result = subprocess.run(control_command(sock, "check", target),
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return result.returncode == 0


def close(sock: Path, target: str) -> None:
    if active(sock, target):
        subprocess.run(control_command(sock, "exit", target),
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       check=False)
    if sock.exists() and not active(sock, target):
        sock.unlink()


def roles_for(machine: str, names: list[str]) -> list[tuple[str, str]]:
    if machine != "laptop":
        return [("compute", GATEWAY)]
    roles = [("omen", OMEN)] if any(SERVICES[name][0] is not None for name in names) else []
    return [*roles, ("gateway", GATEWAY)]


def list_services() -> None:
    print(f"{'SERVICE':29} {'OMEN':>5} {'LAPTOP':>7} {'GATEWAY':>7} {'COMPUTE':>7}")
    for name, ports in SERVICES.items():
        omen = "-" if ports[0] is None else str(ports[0])
        print(f"{name:29} {omen:>5} {ports[1]:7} {gateway_port(name):7} {ports[3]:7}")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("machine", choices=("laptop", "compute", "list"))
    parser.add_argument("action", nargs="?", choices=("start", "status", "stop", "list", "check"))
    parser.add_argument("services", nargs="*", metavar="SERVICE")
    parser.add_argument("--dry-run", action="store_true", help="print SSH commands without connecting")
    parser.add_argument("--no-check", action="store_true",
                        help="compute start: skip the check that the web app listens on this machine")
    args = parser.parse_args()
    if args.machine == "list" or args.action == "list":
        list_services()
        return 0
    if args.action == "check":
        # laptop: the whole route through the gateway; compute: the web app itself.
        return check_ui(SERVICES["harness-ui"][1 if args.machine == "laptop" else 3])
    if not args.action:
        parser.error("choose start, status, or stop")
    folder = runtime_dir()
    state = folder / f"{args.machine}.json"
    recorded = json.loads(state.read_text()) if state.exists() else {}
    recorded_targets = recorded.get("targets", {})
    names = selected_services(args.services) if args.action == "start" else recorded.get("services", [])
    if not names:
        names = selected_services(args.services)
    roles = roles_for(args.machine, names)
    old_roles = [(role, recorded_targets.get(role, target)) for role, target in roles]
    if args.action == "start":
        if args.dry_run:
            for role, _ in roles:
                print(shlex.join(ssh_command(role, names, folder / f"{role}.sock")))
            return 0
        if args.machine == "compute" and not args.no_check:
            check_ui_server(names)
        if state.exists() and all(active(folder / f"{role}.sock", target) for role, target in old_roles):
            offset = recorded.get("gateway_port_offset")
            if offset is not None and offset != GATEWAY_PORT_OFFSET:
                raise RuntimeError(
                    f"Tunnels with gateway port offset {offset} are running; this command uses "
                    f"{GATEWAY_PORT_OFFSET} (omen-tunnels-external: 1000, omen-tunnels: 0). Use the command they "
                    "were started with, or 'stop' them first.")
            if recorded.get("services") == names and old_roles == roles:
                print(f"Already running: {', '.join(names)}")
                return 0
            raise RuntimeError("Different services or Omen host are running. Run 'stop' first, then 'start'.")
        # Recover only this tool's stale control sockets; never touch unrelated SSH sessions.
        for role, target in old_roles:
            sock = folder / f"{role}.sock"
            if active(sock, target):
                raise RuntimeError(f"Existing {role} tunnel found without matching state. Run '{args.machine} stop'.")
            if sock.exists():
                sock.unlink()
        started = []
        try:
            for role, target in roles:
                sock = folder / f"{role}.sock"
                print(f"Starting {role} hop to {target}...", flush=True)
                try:
                    subprocess.run(ssh_command(role, names, sock), check=True)
                except subprocess.CalledProcessError as exc:
                    ports = ", ".join(listener_ports(role, names))
                    hint = (
                        "Stop the earlier manual laptop-to-gateway SSH tunnel, then retry. "
                        "If no old tunnel exists, these gateway ports are held by another session."
                        if role == "gateway" else
                        "Stop the earlier manual tunnel on this machine or choose free ports."
                    )
                    raise RuntimeError(f"Cannot start {role} hop; listener port(s): {ports}. {hint}") from exc
                if not active(sock, target):
                    raise RuntimeError(f"SSH did not keep the {role} tunnel running")
                started.append((sock, target))
            state.write_text(json.dumps({"services": names, "targets": dict(roles),
                                         "gateway_port_offset": GATEWAY_PORT_OFFSET}) + "\n")
            state.chmod(0o600)
        except Exception:
            for sock, target in reversed(started):
                close(sock, target)
            raise
        print("\n".join(ready_lines(args.machine, names)))
        return 0
    if args.action == "status":
        names = recorded.get("services", [])
        print("Services:", ", ".join(names) if names else "none recorded")
        offset = recorded.get("gateway_port_offset")
        if offset is not None:
            print(f"Gateway port offset: {offset}; gateway ports: "
                  + ", ".join(f"{name} {SERVICES[name][2] + offset}" for name in names))
            if offset != GATEWAY_PORT_OFFSET:
                print(f"Warning: started with offset {offset}, this command uses {GATEWAY_PORT_OFFSET} "
                      "(omen-tunnels-external: 1000, omen-tunnels: 0)")
        for role, target in old_roles:
            print(f"{role}: {'up' if active(folder / f'{role}.sock', target) else 'down'}")
        return 0
    for role, target in reversed(old_roles):
        close(folder / f"{role}.sock", target)
        print(f"Stopped {role} hop")
    state.unlink(missing_ok=True)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as exc:
        print(f"omen-tunnels: {exc}", file=sys.stderr)
        sys.exit(1)

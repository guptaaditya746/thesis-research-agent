@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

# A small subset of the QUDT units vocabulary (https://qudt.org/), with the IRIs, labels and symbols QUDT uses.
# The full file can be fetched into $EV_ONTOLOGY_DIR/qudt_units.ttl; it then replaces this one.
unit:PERCENT a qudt:Unit ; rdfs:label "percent" ; qudt:symbol "%" .
unit:SEC a qudt:Unit ; rdfs:label "second" ; qudt:symbol "s" .
unit:MilliSEC a qudt:Unit ; rdfs:label "millisecond" ; qudt:symbol "ms" .
unit:MIN a qudt:Unit ; rdfs:label "minute" ; qudt:symbol "min" .
unit:HR a qudt:Unit ; rdfs:label "hour" ; qudt:symbol "h" .
unit:DAY a qudt:Unit ; rdfs:label "day" ; qudt:symbol "d" .
unit:KiloGM a qudt:Unit ; rdfs:label "kilogram" ; qudt:symbol "kg" .
unit:GM a qudt:Unit ; rdfs:label "gram" ; qudt:symbol "g" .
unit:MilliGM a qudt:Unit ; rdfs:label "milligram" ; qudt:symbol "mg" .
unit:M a qudt:Unit ; rdfs:label "metre" ; qudt:symbol "m" .
unit:MilliM a qudt:Unit ; rdfs:label "millimetre" ; qudt:symbol "mm" .
unit:L a qudt:Unit ; rdfs:label "litre" ; qudt:symbol "L" .
unit:MilliMOL-PER-L a qudt:Unit ; rdfs:label "millimole per litre" ; qudt:symbol "mmol/L" .
unit:MilliM_HG a qudt:Unit ; rdfs:label "millimetre of mercury" ; qudt:symbol "mmHg" .
unit:DEG_C a qudt:Unit ; rdfs:label "degree Celsius" ; qudt:symbol "°C" .
unit:GigaHZ a qudt:Unit ; rdfs:label "gigahertz" ; qudt:symbol "GHz" .
unit:GigaBYTE a qudt:Unit ; rdfs:label "gigabyte" ; qudt:symbol "GB" .

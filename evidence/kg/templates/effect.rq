# params: sides, metrics, higher_is_better, min_effect
# decisions: threshold=min_effect, counts_as=metrics, must_match=must_match
# after: effect
# One treatment/control study per paper: all values on the question metrics, paired in evidence/kg/after.py.
# sides [treatment side, control side]; metrics (the question metrics, priority order: the counts-as decision);
# higher_is_better {metric: bool}; min_effect (the threshold decision); optional must_match: treatment and control
# values must come from experiments with equal settings for those fields.
SELECT * WHERE {
  ?value a ev:Value ; ev:of ?t ; ev:onMetric ?m ; ev:number ?number ; ev:inExperiment ?e ;
         kg:position ?position ; kg:inTable ?inTable ; kg:side ?side .
  ?e ev:inPaper ?p .
  ?m ev:name ?metric .
  ?p ev:name ?paper .
  OPTIONAL { ?value kg:context ?context }
  $must_match_values[?e]
  VALUES ?side { $sides }
  VALUES ?metric { $metrics }
  $include[?paper]
}
ORDER BY ?paper ?position ?value

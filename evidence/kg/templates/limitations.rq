# params:
# Limitations the papers state, per thing they are about ("unlinked" for the study as a whole) and category, with the
# number of papers. Limitation items are claims of relation "limitation" in the graph.
SELECT ?thing ?category (COUNT(DISTINCT ?paper) AS ?papers) WHERE {
  ?c a ev:Claim ; ev:relation "limitation" ; ev:inPaper ?p ; ev:object ?category .
  ?p ev:name ?paper .
  OPTIONAL { ?c ev:subject ?subject }
  BIND(COALESCE(?subject, "unlinked") AS ?thing)
  $include[?paper]
}
GROUP BY ?thing ?category
ORDER BY LCASE(?thing) ?category

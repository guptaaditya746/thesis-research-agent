# Does a paper's claim about a thing (ev:direction) agree with its own numbers? One row per claim and comparison
# that involves the thing the claim is about (matched on the name, case ignored); a difference under $threshold is
# "no_effect". Params: threshold; include (optional papers).
SELECT ?paper ?subject ?direction ?delta ?data ?agrees WHERE {
  ?claim a ev:Claim ; ev:inPaper ?p ; ev:subject ?subject ; ev:direction ?direction .
  ?p ev:name ?paper .
  ?c a ev:Comparison ; ev:a ?va ; ev:b ?vb ; ev:inExperiment ?e .
  ?e ev:inPaper ?p .
  { ?c ev:delta ?d1 ; ev:a/ev:of ?t . BIND(?d1 AS ?delta) } UNION { ?c ev:delta ?d2 ; ev:b/ev:of ?t . BIND(0 - ?d2 AS ?delta) }
  ?t ev:name ?name .
  FILTER(LCASE(STR(?name)) = LCASE(STR(?subject)))
  ?va ev:onMetric ?m .
  OPTIONAL { ?m kg:higherIsBetter ?hib }
  BIND(IF(ABS(?delta) < $threshold, "no_effect",
          IF((?delta > 0) = COALESCE(?hib, true), "improves", "worsens")) AS ?data)
  BIND(?data = ?direction AS ?agrees)
  $include[?paper]
}
ORDER BY ?paper ?subject ?c

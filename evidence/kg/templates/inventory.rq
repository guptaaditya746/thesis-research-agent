# What the papers measured: each thing with the number of papers it is in. Params: include (optional papers).
SELECT (MIN(?name) AS ?thing) (COUNT(DISTINCT ?paper) AS ?papers) WHERE {
  ?v a ev:Value ; ev:of ?t ; ev:inExperiment ?e .
  ?t ev:name ?name .
  ?e ev:inPaper ?p .
  ?p ev:name ?paper .
  $include[?paper]
}
GROUP BY ?t
ORDER BY DESC(?papers) ?thing

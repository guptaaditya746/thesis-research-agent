PREFIX ev: <https://w3id.org/thesis-ev#>
PREFIX kg: <https://w3id.org/thesis-ev/kg#>
# Papers that report a dataset no other paper uses.
SELECT DISTINCT ?paper ?dataset WHERE {
  ?v a ev:Value ; ev:inExperiment ?e ; kg:context ?dataset .
  ?e ev:inPaper ?p .
  ?p ev:name ?paper .
  FILTER NOT EXISTS {
    ?v2 a ev:Value ; ev:inExperiment ?e2 ; kg:context ?dataset .
    ?e2 ev:inPaper ?p2 .
    FILTER(?p2 != ?p)
  }
}
ORDER BY ?paper ?dataset

@prefix ev: <https://w3id.org/thesis-ev#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ---- Classes ----

ev:Paper a rdfs:Class ;
    rdfs:comment "A document the system reads: one paper, report or thesis, with its own identifier." .

ev:Experiment a rdfs:Class ;
    rdfs:comment "One experiment or study in a paper. Its settings are written as ev:setting_<field> properties, one per setting key (for example ev:setting_dataset, ev:setting_model). Those properties are not declared here because the keys are not fixed: a new setting key needs no change to this file." .

ev:Thing a rdfs:Class ;
    rdfs:comment "Something a value is about, such as a method, dataset or model. Its kind is given by rdf:type to an ontology class; 'kind of' is rdfs:subClassOf*." .

ev:Metric a rdfs:Class ;
    rdfs:comment "A measured quantity, such as accuracy or F1. Its kind is given by rdf:type to an ontology class; 'kind of' is rdfs:subClassOf*." .

ev:Value a rdfs:Class ;
    rdfs:comment "One reported number: a metric measured for a thing in an experiment." .

ev:Claim a rdfs:Class ;
    rdfs:comment "An open claim a paper makes about a subject (its own words in ev:relation), with strength and direction. Claims also take ev:setting_<field> properties, one per setting key, like ev:Experiment." .

ev:Link a rdfs:Class ;
    rdfs:comment "A link from one paper to another work it cites, or to a work outside the document set." .

ev:Comparison a rdfs:Class ;
    rdfs:comment "A comparison of two values (ev:a and ev:b) on the same metric, with the difference (ev:delta) and the better one (ev:better)." .

# ---- Properties: where a record sits ----

ev:inPaper a rdf:Property ;
    rdfs:comment "Links an experiment, claim or link to the paper (ev:Paper) it was found in." .

ev:inExperiment a rdf:Property ;
    rdfs:comment "Links a value to the experiment (ev:Experiment) it was reported in." .

# ---- Properties: values ----

ev:of a rdf:Property ;
    rdfs:domain ev:Value ;
    rdfs:range ev:Thing ;
    rdfs:comment "Links a value to the thing (ev:Thing) it is a measurement of." .

ev:onMetric a rdf:Property ;
    rdfs:domain ev:Value ;
    rdfs:range ev:Metric ;
    rdfs:comment "Links a value to the metric (ev:Metric) it measures." .

ev:number a rdf:Property ;
    rdfs:domain ev:Value ;
    rdfs:comment "The reported number of a value, as a literal." .

ev:source a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:comment "The source span of a record, held as a JSON string (a string literal containing JSON): where in the paper the record's text was found." .

ev:name a rdf:Property ;
    rdfs:comment "The name a paper gives a thing, metric or experiment, as a literal." .

# ---- Properties: comparisons ----

ev:a a rdf:Property ;
    rdfs:domain ev:Comparison ;
    rdfs:range ev:Value ;
    rdfs:comment "The first value of a comparison." .

ev:b a rdf:Property ;
    rdfs:domain ev:Comparison ;
    rdfs:range ev:Value ;
    rdfs:comment "The second value of a comparison." .

ev:delta a rdf:Property ;
    rdfs:domain ev:Comparison ;
    rdfs:comment "The difference between the two values of a comparison (a number literal)." .

ev:better a rdf:Property ;
    rdfs:domain ev:Comparison ;
    rdfs:range ev:Value ;
    rdfs:comment "The value of the comparison that is the better one." .

# ---- Properties: claims ----

ev:subject a rdf:Property ;
    rdfs:domain ev:Claim ;
    rdfs:comment "What the claim is about: the subject, as a literal." .

ev:relation a rdf:Property ;
    rdfs:comment "The paper's own verb: for a claim (for example 'raises' or 'hurts') or for a link (the link's verb). No rdfs:domain, because claims and links both use it. As a literal." .

ev:relationGroup a rdf:Property ;
    rdfs:domain ev:Claim ;
    rdfs:comment "The grouped verb of a claim, filled after the run (for example 'raises' and 'boosts' both become 'increases'). Queries match on this literal." .

ev:object a rdf:Property ;
    rdfs:domain ev:Claim ;
    rdfs:comment "The object of the claim (what the subject acts on), as a literal. Absent when the claim has no object." .

ev:strength a rdf:Property ;
    rdfs:domain ev:Claim ;
    rdfs:comment "How firmly the paper states the claim: the literal 'firm' or 'hedged'." .

ev:direction a rdf:Property ;
    rdfs:domain ev:Claim ;
    rdfs:comment "The direction of the claim: the literal 'improves', 'worsens' or 'no_effect'. Absent when the claim has no direction." .

# ---- Properties: links ----

ev:cites a rdf:Property ;
    rdfs:domain ev:Link ;
    rdfs:range ev:Paper ;
    rdfs:comment "The paper (ev:Paper) a link points to, when it is in the document set." .

ev:outsideSet a rdf:Property ;
    rdfs:domain ev:Link ;
    rdfs:comment "True (boolean literal) when the link points to a work outside the document set." .

ev:ref a rdf:Property ;
    rdfs:domain ev:Link ;
    rdfs:comment "The reference a link names, as a literal: a DOI, an arXiv id or the cited text, whatever the paper gave." .

# ---- Properties: provenance ----

ev:madeBy a rdf:Property ;
    rdfs:comment "Who made a claim or link: the literal 'code', 'llm' or 'human'." .

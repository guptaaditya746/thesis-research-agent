# SHACL shapes: the rules every seed file must pass (checked by `evqa seed check` with pyshacl).
# One shape per class in glue.ttl, plus SPARQL rules for what plain shapes cannot say.

@prefix ex:   <https://w3id.org/evqa/seed#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

ex:QuantityShape a sh:NodeShape ;
    sh:property [ sh:path qudt:numericValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ,
                [ sh:path qudt:unit ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

ex:NamedShape a sh:NodeShape ;
    sh:targetClass ex:Item , ex:Measure , ex:Context , ex:Factor ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

ex:MeasureShape a sh:NodeShape ;
    sh:targetClass ex:Measure ;
    sh:property [ sh:path ex:higherIsBetter ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ,
                [ sh:path ex:unit ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

ex:ConditionShape a sh:NodeShape ;
    sh:targetClass ex:Condition ;
    sh:property [ sh:path ex:factor ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ex:Factor ] ,
                [ sh:path ex:setting ; sh:minCount 1 ; sh:maxCount 1 ; sh:node ex:QuantityShape ] .

ex:PaperShape a sh:NodeShape ;
    sh:targetClass ex:Paper ;
    sh:property [ sh:path dcterms:title ; sh:minCount 1 ; sh:maxCount 1 ] ,
                [ sh:path ex:domain ; sh:minCount 1 ; sh:maxCount 1 ] ,
                [ sh:path ex:role ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "hub" "series" "near_miss" "filler" "dose_ranging" "trend"
                                                                    "conflict" "multi_arm" "head_to_head" "alias" "distractor" ) ] ,
                [ sh:path ex:split ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "practice" "test" ) ] ,
                [ sh:path ex:evidenceKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ex:EvidenceKind ] ,
                [ sh:path ex:mention ; sh:node ex:MentionShape ] .

ex:MentionShape a sh:NodeShape ;
    sh:property [ sh:path ex:item ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ex:Item ] ,
                [ sh:path ex:written ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "name" "code" "both" ) ] .

ex:ResultShape a sh:NodeShape ;
    sh:targetClass ex:Result ;
    sh:property [ sh:path ex:subject ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ex:Item ] ,
                [ sh:path ex:comparator ; sh:maxCount 1 ; sh:class ex:Item ] ,
                [ sh:path sosa:observedProperty ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ex:Measure ] ,
                [ sh:path sosa:hasFeatureOfInterest ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ex:Context ] ,
                [ sh:path ex:condition ; sh:maxCount 1 ; sh:class ex:Condition ] ,
                [ sh:path ex:atTime ; sh:maxCount 1 ; sh:node ex:QuantityShape ] ,
                [ sh:path ex:statistic ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ex:Statistic ] ,
                [ sh:path sosa:hasResult ; sh:minCount 1 ; sh:maxCount 1 ; sh:node ex:QuantityShape ] ,
                [ sh:path ex:reportedIn ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ex:Paper ] ,
                [ sh:path ex:placement ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "table" "text" ) ] ,
                [ sh:path ex:conflictsWith ; sh:class ex:Result ] ;
    # A difference or ratio needs a comparator; a group mean has none.
    sh:sparql [ sh:message "comparator does not fit the statistic" ;
        sh:select """
            PREFIX ex: <https://w3id.org/evqa/seed#>
            SELECT $this WHERE {
              $this ex:statistic ?s .
              OPTIONAL { $this ex:comparator ?c }
              FILTER ( (?s IN (ex:MeanDifference, ex:Ratio) && !BOUND(?c)) || (?s = ex:MeanValue && BOUND(?c)) )
            }""" ] ;
    # The value is stored in the unit its measure names.
    sh:sparql [ sh:message "value unit differs from the measure's unit" ;
        sh:select """
            PREFIX ex: <https://w3id.org/evqa/seed#>
            PREFIX sosa: <http://www.w3.org/ns/sosa/>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this WHERE {
              $this sosa:observedProperty/ex:unit ?want ; sosa:hasResult/qudt:unit ?got .
              FILTER (?want != ?got)
            }""" ] ;
    # A conflict links two papers' rows about the same fact with different values.
    sh:sparql [ sh:message "conflictsWith must link the same fact in another paper, with another value" ;
        sh:select """
            PREFIX ex: <https://w3id.org/evqa/seed#>
            PREFIX sosa: <http://www.w3.org/ns/sosa/>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this WHERE {
              $this ex:conflictsWith ?o .
              FILTER NOT EXISTS {
                $this ex:subject ?s ; ex:comparator ?c ; sosa:observedProperty ?m ; sosa:hasFeatureOfInterest ?x ;
                      ex:condition ?k ; ex:atTime/qudt:numericValue ?t ; ex:reportedIn ?p1 ;
                      sosa:hasResult/qudt:numericValue ?v1 .
                ?o ex:subject ?s ; ex:comparator ?c ; sosa:observedProperty ?m ; sosa:hasFeatureOfInterest ?x ;
                   ex:condition ?k ; ex:atTime/qudt:numericValue ?t ; ex:reportedIn ?p2 ;
                   sosa:hasResult/qudt:numericValue ?v2 ; ex:conflictsWith $this .
                FILTER (?p1 != ?p2 && ?v1 != ?v2)
              }
            }""" ] ;
    # One fact per (paper, subject, comparator, measure, context, condition, time, statistic).
    sh:sparql [ sh:message "two results describe the same fact" ;
        sh:select """
            PREFIX ex: <https://w3id.org/evqa/seed#>
            PREFIX sosa: <http://www.w3.org/ns/sosa/>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this WHERE {
              $this ex:reportedIn ?p ; ex:subject ?s ; sosa:observedProperty ?m ;
                    sosa:hasFeatureOfInterest ?x ; ex:statistic ?st .
              ?other ex:reportedIn ?p ; ex:subject ?s ; sosa:observedProperty ?m ;
                    sosa:hasFeatureOfInterest ?x ; ex:statistic ?st .
              FILTER (?other != $this)
              OPTIONAL { $this ex:comparator ?c1 } OPTIONAL { ?other ex:comparator ?c2 }
              OPTIONAL { $this ex:condition ?k1 } OPTIONAL { ?other ex:condition ?k2 }
              OPTIONAL { $this ex:atTime/qudt:numericValue ?t1 } OPTIONAL { ?other ex:atTime/qudt:numericValue ?t2 }
              FILTER (COALESCE(?c1, 0) = COALESCE(?c2, 0) && COALESCE(?k1, 0) = COALESCE(?k2, 0)
                      && COALESCE(?t1, -1) = COALESCE(?t2, -1))
            }""" ] .

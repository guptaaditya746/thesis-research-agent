# Glue file: our only hand-written schema. Everything else is reused.
# Result row = sosa:Observation; value+unit = qudt:QuantityValue; source = PROV-O; names = SKOS.
# Our own terms cover only what no published ontology has on a result:
# subject, comparator, condition (dose / processing setting), time point, statistic, evidence kind.

@prefix ex:      <https://w3id.org/evqa/seed#> .
@prefix sosa:    <http://www.w3.org/ns/sosa/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix qudt:    <http://qudt.org/schema/qudt/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/evqa/seed> a owl:Ontology ;
    rdfs:label "Evidence QA seed glue" ;
    owl:versionInfo "0.2 draft 2026-11-21" .

# ---------- classes ----------
ex:Paper      a owl:Class ; rdfs:subClassOf prov:Entity ;
    skos:definition "One synthetic paper in the corpus." .
ex:Result     a owl:Class ; rdfs:subClassOf sosa:Observation ;
    skos:definition "One fact row: one number about one subject, measure, condition and time, in one paper." .
ex:Item       a owl:Class ;
    skos:definition "The thing being tested or compared: a drug, placebo, alloy, process route." .
ex:Measure    a owl:Class ; rdfs:subClassOf sosa:ObservableProperty ;
    skos:definition "What is measured: HbA1c change, yield strength." .
ex:Context    a owl:Class ; rdfs:subClassOf sosa:FeatureOfInterest ;
    skos:definition "Who or what was measured: a patient group, a specimen type." .
ex:Condition  a owl:Class ;
    skos:definition "One setting of a varying factor: 40 mg daily, aged 8 h at 175 C." .
ex:Factor     a owl:Class ;
    skos:definition "A factor that can vary between results: daily dose, ageing time." .
ex:Statistic  a owl:Class ;
    skos:definition "What kind of number the value is: group mean, mean difference vs comparator, ratio." .
ex:EvidenceKind a owl:Class ;
    skos:definition "How the evidence was made: randomised trial, cohort, lab test, simulation." .

# ---------- result links ----------
ex:subject    a owl:ObjectProperty ; rdfs:domain ex:Result ; rdfs:range ex:Item ;
    skos:definition "The item the number is about." .
ex:comparator a owl:ObjectProperty ; rdfs:domain ex:Result ; rdfs:range ex:Item ;
    skos:definition "The item it is compared against. Absent for single-arm values." .
ex:condition  a owl:ObjectProperty ; rdfs:domain ex:Result ; rdfs:range ex:Condition .
ex:atTime     a owl:ObjectProperty ; rdfs:domain ex:Result ; rdfs:range qudt:QuantityValue ;
    skos:definition "Time point since start, as value + unit (24 weeks)." .
ex:statistic  a owl:ObjectProperty ; rdfs:domain ex:Result ; rdfs:range ex:Statistic .
ex:reportedIn a owl:ObjectProperty ; rdfs:subPropertyOf prov:wasDerivedFrom ;
    rdfs:domain ex:Result ; rdfs:range ex:Paper .
ex:placement  a owl:DatatypeProperty ; rdfs:domain ex:Result ; rdfs:range xsd:string ;
    skos:definition "Where the paper must state it: 'table' or 'text'. Used by the paper writer and Find eval." .
# Reused as is on ex:Result: sosa:observedProperty (-> ex:Measure),
# sosa:hasFeatureOfInterest (-> ex:Context), sosa:hasResult (-> qudt:QuantityValue).

# ---------- other links ----------
ex:factor       a owl:ObjectProperty ; rdfs:domain ex:Condition ; rdfs:range ex:Factor .
ex:setting      a owl:ObjectProperty ; rdfs:domain ex:Condition ; rdfs:range qudt:QuantityValue .
ex:higherIsBetter a owl:DatatypeProperty ; rdfs:domain ex:Measure ; rdfs:range xsd:boolean .
ex:evidenceKind a owl:ObjectProperty ; rdfs:domain ex:Paper ; rdfs:range ex:EvidenceKind .
ex:domain       a owl:DatatypeProperty ; rdfs:domain ex:Paper ; rdfs:range xsd:string .
ex:role         a owl:DatatypeProperty ; rdfs:domain ex:Paper ; rdfs:range xsd:string ;
    skos:definition "Why the paper is in the corpus: hub, series, near_miss, filler, dose_ranging, trend, conflict, multi_arm, head_to_head, alias, distractor." .
ex:mention      a owl:ObjectProperty ; rdfs:domain ex:Paper ;
    skos:definition "How the paper writes a made-up item when not by its name alone (a node with ex:item and ex:written)." .
ex:item         a owl:ObjectProperty ; rdfs:range ex:Item .
ex:written      a owl:DatatypeProperty ; rdfs:range xsd:string ;
    skos:definition "'code' (only the development code, e.g. QLM-331) or 'both' (name and code); default is the name only." .
ex:conflictsWith a owl:ObjectProperty , owl:SymmetricProperty ; rdfs:domain ex:Result ; rdfs:range ex:Result ;
    skos:definition "Another paper states the same fact (subject, comparator, measure, context, condition, time) with a different value. Deliberate, declared in the blueprint." .
ex:split        a owl:DatatypeProperty ; rdfs:domain ex:Paper ; rdfs:range xsd:string ;
    skos:definition "'practice' (prompt tuning only) or 'test' (scores only). Papers and made-up items never cross." .
ex:madeUp       a owl:DatatypeProperty ; rdfs:range xsd:boolean ;
    skos:definition "True for an invented name (checked against MeSH and ChEBI so no model knows it)." .
ex:unit         a owl:ObjectProperty ; rdfs:domain ex:Measure ; rdfs:range qudt:Unit ;
    skos:definition "The unit every value of this measure is stored in (QUDT)." .

# ---------- fixed concept lists ----------
ex:MeanValue      a ex:Statistic ; skos:prefLabel "group mean" .
ex:MeanDifference a ex:Statistic ; skos:prefLabel "mean difference vs comparator" .
ex:Ratio          a ex:Statistic ; skos:prefLabel "ratio vs comparator" .
# TODO: add skos:exactMatch to the STATO terms once IDs are checked.

ex:RCT        a ex:EvidenceKind ; skos:prefLabel "randomised controlled trial" .
ex:Cohort     a ex:EvidenceKind ; skos:prefLabel "cohort study" .
ex:LabTest    a ex:EvidenceKind ; skos:prefLabel "laboratory test" .
ex:Simulation a ex:EvidenceKind ; skos:prefLabel "simulation" .

# ---------- units QUDT lacks ----------
# A change of a value that is itself a percent (HbA1c 7.9% -> 6.8%) is in percentage points, not percent.
ex:PercentagePoint a qudt:Unit ;
    rdfs:label "percentage point" ; qudt:symbol "pp" ;
    qudt:conversionMultiplier 0.01 ;
    skos:definition "Difference between two percent values. Kept apart from unit:PERCENT (a relative change)." .

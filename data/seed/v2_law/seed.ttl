    ex:inPaper ex:LAW-05 ;
    ex:object ex:BP3 ;
    ex:relation ex:relies_on ;
    ex:subject ex:BD2 .

ex:BD3 a ex:Decision,
        ex:Entity ;
    skos:prefLabel "Gothukur v. Didota Media" ;
    ex:court ex:C2 ;
    ex:facts "a broadcasting commission revoked a license without allowing the licensee to respond to new evidence of misconduct" ;
    ex:outcome "revocation quashed; case remitted for a hearing in accordance with procedural rights" ;
    ex:year 2018 .

ex:BD4-relies_on-BP4 a ex:Fact ;
    ex:inPaper ex:LAW-05 ;
    ex:object ex:BP4 ;
    ex:relation ex:relies_on ;
    ex:subject ex:BD4 .


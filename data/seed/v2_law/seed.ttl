    ex:inPaper ex:LAW-05 ;
    ex:object ex:BP3 ;
    ex:relation ex:relies_on ;
    ex:subject ex:BD5 .

ex:BD6 a ex:Decision,
        ex:Entity ;
    skos:prefLabel "Thisas v. Ribror Health" ;
    ex:court ex:C3 ;
    ex:facts "a public health agency issued a directive restricting movement without providing written reasons, relying on emergency powers" ;
    ex:outcome "directive upheld; court ruled that in emergencies, the duty to give reasons is satisfied by the public announcement of the directive" ;
    ex:year 2024 .

ex:BP2 a ex:Entity,
        ex:Provision ;
    skos:prefLabel "section 12 of the Tetre Administrative Procedure Act" ;
    ex:summary "before a final decision is made, the affected party must be given a reasonable opportunity to present their case and respond to any adverse evidence" ;
    ex:topic "right to be heard" .

ex:CD1-rejects-CP3 a ex:Fact ;
    ex:inPaper ex:LAW-09 ;
    ex:object ex:CP3 ;
    ex:relation ex:rejects ;
    ex:subject ex:CD1 .


ex:AD1-relies_on-AP1 a ex:Fact ;
    ex:inPaper ex:LAW-01 ;
    ex:object ex:AP1 ;
    ex:relation ex:relies_on ;
    ex:subject ex:AD1 .

ex:AD2-relies_on-AP1 a ex:Fact ;
    ex:inPaper ex:LAW-01 ;
    ex:object ex:AP1 ;
    ex:relation ex:relies_on ;
    ex:subject ex:AD2 .

ex:AD3 a ex:Decision,
        ex:Entity ;
    skos:prefLabel "Pomuthel v. Hemem Insurance" ;
    ex:court ex:C2 ;
    ex:facts "a reorganization plan was submitted, but a class of unsecured creditors voted against it, arguing the plan did not provide sufficient recovery" ;
    ex:outcome "plan rejected; the court held that the two-thirds in amount threshold was not met in the impaired class" ;
    ex:year 2018 .

ex:AD4 a ex:Decision,
        ex:Entity ;
    skos:prefLabel "Kuhizun v. Trefezer Media" ;
    ex:court ex:C1 ;
    ex:facts "a creditor alleged that the debtor had transferred assets to a related party eight months before insolvency proceedings began, with the intent to defraud other creditors" ;
    ex:outcome "transfer voided; the court found clear evidence of fraudulent intent and ordered the assets returned to the estate" ;
    ex:year 2020 .

ex:AD5 a ex:Decision,
        ex:Entity ;
    skos:prefLabel "Bruse v. Kikom Health" ;
    ex:court ex:C2 ;
    ex:facts "the debtor argued that a transfer made to a supplier six months before insolvency was a normal business transaction and not fraudulent, despite the debtor being in financial distress" ;
    ex:outcome "transfer upheld; the court distinguished earlier case law and found no intent to hinder or defraud, as the supplier provided essential services" ;
    ex:year 2022 .

ex:AD6-distinguishes-AD1 a ex:Fact ;
    ex:inPaper ex:LAW-01 ;
    ex:object ex:AD1 ;
    ex:relation ex:distinguishes ;
    ex:subject ex:AD6 .


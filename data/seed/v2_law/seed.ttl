    ex:inPaper ex:LAW-01 ;
    ex:object ex:AP1 ;
    ex:relation ex:rejects ;
    ex:subject ex:AD6 .

ex:AD6-rejects-AP2 a ex:Fact ;
    ex:inPaper ex:LAW-01 ;
    ex:object ex:AP2 ;
    ex:relation ex:rejects ;
    ex:subject ex:AD6 .

ex:AP3 a ex:Entity,
        ex:Provision ;
    skos:prefLabel "section 25 of the Tetre Corporate Insolvency Act" ;
    ex:summary "a reorganization plan is confirmed only if it is accepted by a majority in number and two-thirds in amount of the voting creditors in each impaired class" ;
    ex:topic "creditor voting on reorganization plans" .

ex:AP4 a ex:Entity,
        ex:Provision ;
    skos:prefLabel "section 31 of the Tetre Corporate Insolvency Act" ;
    ex:summary "transfers made by the debtor within one year before the commencement of proceedings are voidable if made with intent to hinder, delay, or defraud creditors" ;
    ex:topic "avoidance of pre-insolvency transfers" .

ex:BD1-relies_on-BP4 a ex:Fact ;
    ex:inPaper ex:LAW-05 ;
    ex:object ex:BP4 ;
    ex:relation ex:relies_on ;
    ex:subject ex:BD1 .


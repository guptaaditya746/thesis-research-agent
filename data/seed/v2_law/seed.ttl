ex:LAW-05 a ex:Paper .

ex:LAW-09 a ex:Paper .

ex:C1 a ex:Court,
        ex:Entity ;
    skos:altLabel "District Court" ;
    skos:prefLabel "Tetre District Court" ;
    ex:level 1 .

ex:Provision rdfs:subClassOf ex:Entity .


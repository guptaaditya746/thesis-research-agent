ex:CB1 a ex:Benchmark,
        ex:Entity ;
    skos:altLabel "Togobe-KW" ;
    skos:prefLabel "the Togobe-KW benchmark" ;
    ex:metric "F1 score" ;
    ex:summary "a collection of news articles and scientific abstracts where the goal is to identify the top five most relevant keywords from the text" ;

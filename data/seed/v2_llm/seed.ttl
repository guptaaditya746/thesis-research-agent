    ex:year 2023 .

ex:CM2 a ex:Entity,
        ex:Method ;
    skos:altLabel "Steferis" ;
    skos:prefLabel "Steferis extraction" ;
    ex:family "neural" ;
    ex:summary "uses a transformer encoder to score each token for its likelihood of being a keyword based on context" .

ex:CMO1 a ex:Entity,
        ex:Model ;

ex:AB2 a ex:Benchmark,
        ex:Entity ;
    skos:altLabel "Thipom-POS" ;
    skos:prefLabel "the Thipom-POS benchmark" ;
    ex:metric "tag accuracy" ;
    ex:summary "token-level tagging of morphologically rich languages, measuring the percentage of correctly assigned tags" ;
    ex:task "part-of-speech tagging" .

ex:AM2 a ex:Entity,
        ex:Method ;
    skos:altLabel "Thetran" ;
    skos:prefLabel "Thetran decoding" ;
    ex:family "decoding" ;
    ex:summary "uses a constrained beam search that enforces valid dependency structures during the generation of the target language sentence" .

ex:AM3 a ex:Entity,
        ex:Method ;
    skos:altLabel "Ragrer" ;
    skos:prefLabel "Ragrer adapter" ;
    ex:family "fine-tuning" ;
    ex:summary "inserts small trainable layers into the encoder to capture morphological features of low-resource languages without updating the main weights" .

ex:AS1 a ex:Entity,
        ex:Study ;
    skos:altLabel "Nimel 2021" ;
    skos:prefLabel "the Nimel 2021 study" ;
    ex:benchmark ex:AB1 ;
    ex:model ex:AMO1 ;
    ex:setting "zero-shot" ;
    ex:summary "evaluates the baseline translation performance of the 7B encoder-decoder model on low-resource pairs without any auxiliary methods" ;
    ex:year 2021 .

ex:AS2 a ex:Entity,
        ex:Study ;
    skos:altLabel "Nodrana 2022" ;
    skos:prefLabel "the Nodrana 2022 study" ;
    ex:benchmark ex:AB1 ;
    ex:model ex:AMO1 ;
    ex:setting "few-shot, 5 examples" ;
    ex:summary "tests whether prompting the model to output part-of-speech tags before translation improves BLEU scores on the low-resource benchmark" ;
    ex:year 2022 .

ex:BM2 a ex:Entity,
        ex:Method ;
    skos:altLabel "Bruke" ;
    skos:prefLabel "Bruke retrieval" ;
    ex:family "retrieval" ;
    ex:summary "retrieves similar documents from a corpus to provide context for the model to infer the underlying topics of the target text" .

ex:BM3 a ex:Entity,
        ex:Method ;
    skos:altLabel "Brulum" ;
    skos:prefLabel "Brulum decoding" ;
    ex:family "decoding" ;
    ex:summary "uses a constrained decoding strategy that forces the model to output only words from a predefined vocabulary of topic labels" .

ex:BS6 a ex:Entity,
        ex:Study ;
    skos:altLabel "Nozur 2026" ;
    skos:prefLabel "the Nozur 2026 study" ;
    ex:benchmark ex:BB2 ;
    ex:model ex:BMO2 ;
    ex:setting "zero-shot" ;
    ex:summary "attempts to replicate the findings of the 2022 study on retrieval-augmented theme extraction but fails to observe the same performance gains" ;
    ex:year 2026 .

ex:CM1 a ex:Entity,
        ex:Method ;
    skos:altLabel "Trasor" ;
    skos:prefLabel "Trasor extraction" ;
    ex:family "graph-based" ;
    ex:summary "builds a co-occurrence graph of terms in a document and ranks them by centrality to select keywords" .

ex:CS1 a ex:Entity,
        ex:Study ;
    skos:altLabel "Braliram 2021" ;
    skos:prefLabel "the Braliram 2021 study" ;
    ex:benchmark ex:CB1 ;
    ex:model ex:CMO1 ;
    ex:setting "zero-shot" ;
    ex:summary "evaluates the graph-based method on keyword extraction, finding it outperforms the baseline by 4% F1" ;
    ex:year 2021 .

ex:AM1 a ex:Entity,
        ex:Method ;
    skos:altLabel "Kabaso" ;
    skos:prefLabel "Kabaso prompting" ;
    ex:family "prompting" ;
    ex:summary "instructs the model to output the part-of-speech tag for each token in a sentence before generating the translation" .

ex:AS4 a ex:Entity,
        ex:Study ;
    skos:altLabel "Vofal 2024" ;
    skos:prefLabel "the Vofal 2024 study" ;
    ex:benchmark ex:AB2 ;
    ex:model ex:AMO2 ;
    ex:setting "zero-shot" ;
    ex:summary "assesses the accuracy of the 13B model in assigning part-of-speech tags to morphologically rich languages without any specific prompting strategy" ;
    ex:year 2024 .

ex:CB2 a ex:Benchmark,
        ex:Entity ;
    skos:altLabel "Vidra-SUM" ;
    skos:prefLabel "the Vidra-SUM benchmark" ;
    ex:metric "ROUGE-2" ;
    ex:summary "a set of long-form documents paired with human-written summaries, evaluating the model's ability to select the most important sentences" ;
    ex:task "extractive summarization" .

ex:CS2 a ex:Entity,
        ex:Study ;
    skos:altLabel "Lomakra 2022" ;
    skos:prefLabel "the Lomakra 2022 study" ;
    ex:benchmark ex:CB1 ;
    ex:model ex:CMO2 ;
    ex:setting "few-shot, 5 examples" ;
    ex:summary "tests the neural method on keyword extraction, reporting a significant gain over the zero-shot baseline" ;
    ex:year 2022 .

ex:CS4 a ex:Entity,
        ex:Study ;
    skos:altLabel "Grovim 2024" ;
    skos:prefLabel "the Grovim 2024 study" ;
    ex:benchmark ex:CB1 ;
    ex:model ex:CMO2 ;
    ex:setting "zero-shot" ;
    ex:summary "re-evaluates the neural method on keyword extraction, finding no clear difference from the baseline score" ;
    ex:year 2024 .

ex:AMO1 a ex:Entity,
        ex:Model ;
    skos:altLabel "Tedroso" ;
    skos:prefLabel "Tedroso-7B" ;
    ex:size "7B" ;
    ex:summary "a multilingual encoder-decoder model trained on parallel corpora for low-resource language pairs" .

ex:AMO2 a ex:Entity,
        ex:Model ;
    skos:altLabel "Thoradram" ;
    skos:prefLabel "Thoradram-13B" ;
    ex:size "13B" ;
    ex:summary "a large decoder-only model with strong morphological analysis capabilities, fine-tuned for translation tasks" .

ex:BB1 a ex:Benchmark,
        ex:Entity ;
    skos:altLabel "Tilutron-Topic" ;
    skos:prefLabel "the Tilutron-Topic benchmark" ;
    ex:metric "macro-averaged F1 score" ;
    ex:summary "a collection of short documents labeled with one or more topic categories from a fixed set of 50 labels" ;
    ex:task "document topic classification" .

ex:BB2 a ex:Benchmark,
        ex:Entity ;
    skos:altLabel "Vokosti-Theme" ;
    skos:prefLabel "the Vokosti-Theme benchmark" ;
    ex:metric "semantic similarity to reference themes" ;
    ex:summary "long-form articles where the model must generate a list of key themes without a fixed label set, evaluated against human-annotated themes" ;
    ex:task "open-ended theme extraction" .

ex:BM1 a ex:Entity,
        ex:Method ;
    skos:altLabel "Gredapos" ;
    skos:prefLabel "Gredapos prompting" ;
    ex:family "prompting" ;
    ex:summary "instructs the model to identify the main themes in a document and assign a probability score to each theme before generating the final topic list" .

ex:BMO1 a ex:Entity,
        ex:Model ;
    skos:altLabel "Dogres" ;
    skos:prefLabel "Dogres-7B" ;
    ex:size "7B" ;
    ex:summary "a decoder-only model trained on a mix of web text and academic papers, fine-tuned for document summarization" .

ex:BMO2 a ex:Entity,
        ex:Model ;
    skos:altLabel "Sakem" ;
    skos:prefLabel "Sakem-13B" ;
    ex:size "13B" ;
    ex:summary "a large decoder-only model with strong long-context capabilities, trained on a diverse corpus including code and scientific literature" .

ex:BS1 a ex:Entity,

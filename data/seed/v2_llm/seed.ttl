    skos:prefLabel "Kolal-7B" ;
    ex:size "7B" ;
    ex:summary "a decoder-only model trained on a mix of web text and scientific papers, fine-tuned for text extraction tasks" .

ex:CMO2 a ex:Entity,
        ex:Model ;
    skos:altLabel "Stosa" ;
    skos:prefLabel "Stosa-13B" ;
    ex:size "13B" ;
    ex:summary "a large decoder-only model with strong long-context capabilities, trained on a diverse corpus including code and literature" .

